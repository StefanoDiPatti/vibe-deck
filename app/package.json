{
  "name": "vibe-deck",
  "version": "2.2.0",
  "private": true,
  "description": "Turn an old Android 4 tablet into a wireless Stream Deck for Windows and Linux",
  "main": "server/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/bootstrap.js",
    "server": "node server/index.js",
    "setup": "node scripts/bootstrap.js --setup",
    "test": "node --test",
    "e2e": "node scripts/e2e-touch.js && node scripts/e2e-editor.js && node scripts/e2e-market.js",
    "e2e:touch": "node scripts/e2e-touch.js",
    "e2e:editor": "node scripts/e2e-editor.js",
    "e2e:obs": "node scripts/e2e-obs.js",
    "e2e:market": "node scripts/e2e-market.js",
    "site": "node scripts/build-site.js",
    "themes": "node scripts/build-themes.js",
    "demo": "node scripts/demo.js",
    "new:page": "node scripts/new-page.js",
    "new:widget": "node scripts/new-widget.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "express": "^4.22.3",
    "mailparser": "^3.14.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "acorn": "^8.19.0"
  },
  "author": "Stefano Di Patti",
  "repository": {
    "type": "git",
    "url": "https://github.com/StefanoDiPatti/vibe-deck.git"
  }
}
