{
  "apps": {
    "blender": {
      "label": "Blender",
      "toggle": true,
      "windows": { "path": "C:\\Program Files\\Blender Foundation\\Blender *\\blender.exe" },
      "linux": { "path": "blender" }
    },
    "davinci": {
      "label": "DaVinci Resolve",
      "toggle": true,
      "windows": { "path": "C:\\Program Files\\Blackmagic Design\\DaVinci Resolve\\Resolve.exe" },
      "linux": { "path": "/opt/resolve/bin/resolve" }
    },
    "vscode": {
      "label": "VS Code",
      "toggle": true,
      "windows": { "path": "%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe" },
      "linux": { "path": "code" }
    },
    "unreal": {
      "label": "Unreal Editor",
      "toggle": true,
      "windows": { "path": "C:\\Program Files\\Epic Games\\UE_*\\Engine\\Binaries\\Win64\\UnrealEditor.exe" },
      "linux": { "path": "~/UnrealEngine/Engine/Binaries/Linux/UnrealEditor" }
    },
    "radio_montecarlo": {
      "label": "Radio Monte Carlo",
      "toggle": true,
      "process": "brave",
      "title": "unitedradio\\.it/RMC",
      "windows": {
        "path": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
        "args": ["--profile-directory=Default", "--app=https://icy.unitedradio.it/RMC.mp3"]
      },
      "linux": [
        { "path": "brave-browser", "args": ["--app=https://icy.unitedradio.it/RMC.mp3"] },
        { "path": "xdg-open", "args": ["https://icy.unitedradio.it/RMC.mp3"] }
      ]
    },
    "apple_music": {
      "label": "Apple Music",
      "toggle": true,
      "bridge": "apple",
      "windows": {
        "path": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
        "args": ["--profile-directory=Default", "https://music.apple.com/us/new"]
      },
      "linux": [
        { "path": "~/.local/share/applications/brave-blgdilankhbcpipclgpdndahbehalgkh-Default.desktop" },
        { "path": "xdg-open", "args": ["https://music.apple.com"] }
      ]
    },
    "spotify": {
      "label": "Spotify",
      "toggle": true,
      "windows": { "path": "%APPDATA%\\Spotify\\Spotify.exe" },
      "linux": { "path": "spotify" }
    },
    "claude_desktop": {
      "label": "Claude",
      "toggle": true,
      "process": "claude",
      "windows": { "path": "shell:AppsFolder\\Claude_pzs8sxrjxfjjc!Claude" },
      "linux": [
        { "path": "~/.local/share/applications/brave-fmpnliohjhemenmnlpbfagaolkdacoja-Default.desktop", "toggle": false },
        { "path": "xdg-open", "args": ["https://claude.ai"], "toggle": false }
      ]
    },
    "viber": {
      "label": "Viber",
      "windows": { "path": "%LOCALAPPDATA%\\Programs\\Viber\\Viber.exe" },
      "linux": [
        { "path": "~/.local/share/applications/viber.desktop" },
        { "path": "~/.local/opt/Viber/@viberdesktop" },
        { "path": "viber" }
      ]
    },
    "claude_code": {
      "label": "Claude Code",
      "windows": { "path": "powershell.exe", "args": ["-NoExit", "-Command", "claude"], "cwd": "%USERPROFILE%\\Documents\\AI Projects" },
      "linux": [
        { "path": "konsole", "args": ["-e", "claude"], "cwd": "~" },
        { "path": "gnome-terminal", "args": ["--", "claude"], "cwd": "~" },
        { "path": "alacritty", "args": ["-e", "claude"], "cwd": "~" },
        { "path": "kitty", "args": ["claude"], "cwd": "~" },
        { "path": "xterm", "args": ["-e", "claude"], "cwd": "~" }
      ]
    },
    "powershell": {
      "label": "PowerShell",
      "windows": { "path": "powershell.exe", "args": ["-NoExit"], "cwd": "%USERPROFILE%" },
      "linux": { "label": "Terminale", "path": ["konsole", "gnome-terminal", "alacritty", "kitty", "xfce4-terminal", "xterm"], "cwd": "~" }
    },
    "files": {
      "label": "File",
      "windows": { "path": "explorer.exe", "args": ["%USERPROFILE%"] },
      "linux": { "path": "xdg-open", "args": ["~"] }
    },
    "taskmgr": {
      "label": "Gestione attività",
      "windows": { "path": "taskmgr.exe" },
      "linux": { "label": "Monitor di sistema", "path": ["plasma-systemmonitor", "gnome-system-monitor", "ksysguard", "xfce4-taskmanager"] }
    },
    "screenshot": {
      "label": "Screenshot",
      "linux": [
        { "path": "spectacle", "args": ["--region"] },
        { "path": "gnome-screenshot", "args": ["--area"] },
        { "path": "flameshot", "args": ["gui"] }
      ]
    },
    "discord": {
      "label": "Discord",
      "toggle": true,
      "process": "discord",
      "windows": { "path": "%LOCALAPPDATA%\\Discord\\Update.exe", "args": ["--processStart", "Discord.exe"] },
      "linux": { "path": "discord" }
    }
  }
}
