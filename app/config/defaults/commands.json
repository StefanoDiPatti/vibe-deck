{
  "commands": {
    "lock_pc": {
      "label": "Blocca PC",
      "windows": { "cmd": "rundll32.exe", "args": ["user32.dll,LockWorkStation"] },
      "linux": { "cmd": "loginctl", "args": ["lock-session"] }
    },
    "monitor_off": {
      "label": "Schermo spento",
      "windows": { "cmd": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-WindowStyle", "Hidden", "-File", "{root}\\scripts\\windows\\monitor-off.ps1"] },
      "linux": [
        { "cmd": "kscreen-doctor", "args": ["--dpms", "off"] },
        { "cmd": "xset", "args": ["dpms", "force", "off"] }
      ]
    },
    "show_desktop": {
      "label": "Mostra desktop",
      "linux": [
        { "cmd": "qdbus6", "args": ["org.kde.kglobalaccel", "/component/kwin", "org.kde.kglobalaccel.Component.invokeShortcut", "Show Desktop"] },
        { "cmd": "qdbus", "args": ["org.kde.kglobalaccel", "/component/kwin", "org.kde.kglobalaccel.Component.invokeShortcut", "Show Desktop"] },
        { "cmd": "wmctrl", "args": ["-k", "on"] }
      ]
    }
  }
}
