{
  "name": "Next event",
  "description": "Your next calendar event with when and where",
  "icon": "calendar",
  "shape": "value",
  "source": { "type": "calendar.events" },
  "every": 60,
  "show": {
    "icon": "calendar",
    "label": "PROSSIMO EVENTO",
    "value": "{{next.title|default:Niente in programma}}",
    "sub": "{{next.when}} {{next.location}}"
  },
  "size": { "w": 3, "h": 1, "minW": 2, "minH": 1 }
}
