{
  "name": "Volume",
  "description": "Volume dell'uscita audio predefinita, da trascinare",
  "icon": "volup",
  "shape": "slider",
  "source": { "type": "audio.mixer" },
  "every": 3,
  "show": {
    "icon": "volup",
    "label": "VOLUME USCITA",
    "value": "{{output.volume}}",
    "min": 0,
    "max": 100,
    "step": 2,
    "unit": "%",
    "sub": "{{output.name}}"
  },
  "set": { "type": "audio.volume", "value": "{{value}}" },
  "size": { "w": 3, "h": 1, "minW": 2, "minH": 1 }
}
