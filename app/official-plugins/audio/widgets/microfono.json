{
  "name": "Microfono",
  "description": "Volume del microfono predefinito, da trascinare",
  "icon": "mic",
  "shape": "slider",
  "source": { "type": "audio.mixer" },
  "every": 3,
  "show": {
    "icon": "mic",
    "label": "MICROFONO",
    "value": "{{input.volume}}",
    "min": 0,
    "max": 100,
    "step": 2,
    "unit": "%",
    "sub": "{{input.name}}"
  },
  "set": { "type": "audio.volume", "flow": "in", "value": "{{value}}" },
  "size": { "w": 3, "h": 1, "minW": 2, "minH": 1 }
}
