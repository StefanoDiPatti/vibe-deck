{
  "files.associations": {
    "app/config/**/*.json": "jsonc",
    "app/plugins/**/*.json": "jsonc"
  },
  "json.schemas": [
    {
      "fileMatch": ["app/config/pages/*.json", "app/config/defaults/pages/*.json", "app/plugins/*/pages/*.json"],
      "url": "./app/schema/page.schema.json"
    },
    {
      "fileMatch": ["app/config/apps/*.json", "app/plugins/*/apps/*.json"],
      "url": "./app/schema/app.schema.json"
    },
    {
      "fileMatch": ["app/config/commands/*.json", "app/plugins/*/commands/*.json"],
      "url": "./app/schema/command.schema.json"
    }
  ]
}
